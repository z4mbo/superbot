---
import { BUILD_APP_PROMPT } from "@rakazo/plugin-sdk/guide";
import { BUILD_APP_PROMPT_PATH } from "../docs";
import { APPS_PLATFORM_COPY } from "../i18n/apps-platform";

type Props = {
  /** PostHog `data-attr` prefix that tells this placement apart from others. */
  placement: string;
  class?: string;
};

const { placement, class: className } = Astro.props;
const copy = APPS_PLATFORM_COPY.copyPrompt;
---

<div class:list={["copy-prompt", className]} data-copy-prompt>
  <!-- Without JavaScript the button stays hidden and the prompt below is there to select. -->
  <button
    class="button button--primary copy-prompt__button"
    type="button"
    hidden
    data-copy-prompt-button
    data-label={copy.label}
    data-copied={copy.copied}
    data-failed={copy.failed}
    data-attr={`${placement}-copy-build-app-prompt`}
  >
    <svg class="copy-prompt__icon copy-prompt__icon--copy" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="9" y="9" width="12" height="12" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg class="copy-prompt__icon copy-prompt__icon--done" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
    <span data-copy-prompt-label>{copy.label}</span>
  </button>
  <span class="sr-only" role="status" aria-live="polite" data-copy-prompt-status></span>
  <details class="copy-prompt__details">
    <summary>{copy.show}</summary>
    <pre class="copy-prompt__text"><code data-copy-prompt-text>{BUILD_APP_PROMPT}</code></pre>
    <a class="copy-prompt__plain" href={BUILD_APP_PROMPT_PATH}>{copy.plainText}</a>
  </details>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-copy-prompt]")) {
    const button = root.querySelector<HTMLButtonElement>("[data-copy-prompt-button]");
    const label = root.querySelector<HTMLElement>("[data-copy-prompt-label]");
    const status = root.querySelector<HTMLElement>("[data-copy-prompt-status]");
    const text = root.querySelector<HTMLElement>("[data-copy-prompt-text]");
    const details = root.querySelector<HTMLDetailsElement>("details");
    if (!button || !label || !status || !text || !details) continue;
    button.hidden = false;
    let reset = 0;

    const show = (message: string, copied: boolean) => {
      label.textContent = message;
      status.textContent = message;
      button.toggleAttribute("data-copied", copied);
    };

    button.addEventListener("click", async () => {
      window.clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(text.textContent ?? "");
        show(button.dataset.copied ?? "", true);
        reset = window.setTimeout(() => {
          show(button.dataset.label ?? "", false);
          status.textContent = "";
        }, 2400);
      } catch {
        show(button.dataset.failed ?? "", false);
        details.open = true;
        const range = document.createRange();
        range.selectNodeContents(text);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
      }
    });
  }
</script>

<style>
  .copy-prompt {
    display: grid;
    gap: 10px;
    justify-items: start;
    max-width: 100%;
  }

  .copy-prompt__button[hidden] {
    display: none;
  }

  .copy-prompt__icon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .copy-prompt__icon--done,
  .copy-prompt__button[data-copied] .copy-prompt__icon--copy {
    display: none;
  }

  .copy-prompt__button[data-copied] .copy-prompt__icon--done {
    display: block;
  }

  .copy-prompt__details {
    max-width: 100%;
    color: var(--muted-2);
    font-size: 14px;
  }

  .copy-prompt__details summary {
    cursor: pointer;
  }

  .copy-prompt__text {
    max-width: min(640px, 100%);
    max-height: 320px;
    overflow: auto;
    margin: 10px 0 8px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    padding: 14px;
    background: var(--surface);
    color: var(--body);
    font-size: 13px;
    line-height: 1.55;
    white-space: pre-wrap;
    user-select: all;
  }

  .copy-prompt__plain {
    color: var(--blue);
  }
</style>
