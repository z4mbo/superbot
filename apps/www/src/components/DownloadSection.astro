---
import { desktopDownloadHref } from "../github";
import { DOWNLOAD_COPY as copy } from "../i18n/download-plans";
import { CHANGELOG_URL, SELF_HOST_GUIDE_PATH } from "../site";

type Props = { lang?: string };

const { lang } = Astro.props;

const platforms = ["windows", "mac", "linux"] as const;
const commands = ["npx superbot-cli", "npm i -g superbot-cli"];
---

<section id="download" class="section download" lang={lang}>
  <div class="section-intro">
    <h2 class="section-heading">{copy.heading}</h2>
  </div>
  <div class="download__grid">
    <article class="download-card">
      <h3>{copy.desktop}</h3>
      <div class="download-card__buttons">
        {
          platforms.map((platform) => (
            <a
              class="button button--secondary"
              href={desktopDownloadHref(platform)}
              data-attr={`download-${platform}`}
            >
              {copy.platforms[platform]}
            </a>
          ))
        }
      </div>
      <div class="download-card__links">
        <a href={desktopDownloadHref("linux-deb")} data-attr="download-linux-deb">{copy.linuxDeb}</a>
        <a href={CHANGELOG_URL} target="_blank" rel="noopener">{copy.allReleases}</a>
      </div>
    </article>
    <article class="download-card">
      <h3>{copy.terminal}</h3>
      <ul class="download-card__commands">
        {
          commands.map((command) => (
            <li>
              <code><span aria-hidden="true">$ </span>{command}</code>
              <button
                type="button"
                class="download-copy"
                aria-label={`${copy.copy}: ${command}`}
                title={copy.copy}
                data-download-copy={command}
                data-copied={copy.copied}
                data-failed={copy.copyFailed}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="8" y="8" width="12" height="12" rx="2"></rect>
                  <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
                </svg>
                <span class="download-copy__status" aria-live="polite"></span>
              </button>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
  <div class="download__more">
    <a href={`${SELF_HOST_GUIDE_PATH}#local-source-checkout`}>{copy.buildFromSource}</a>
    <a href={SELF_HOST_GUIDE_PATH}>{copy.selfHostGuide}</a>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-download-copy]")) {
    const status = button.querySelector<HTMLElement>(".download-copy__status");
    let reset = 0;
    button.addEventListener("click", async () => {
      const { downloadCopy: command, copied, failed } = button.dataset;
      if (!command || !status) return;
      try {
        await navigator.clipboard.writeText(command);
        status.textContent = copied ?? "";
      } catch {
        status.textContent = failed ?? "";
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        status.textContent = "";
      }, 2400);
    });
  }
</script>

<style>
  .download__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 44px;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    padding: 26px;
  }

  .download-card h3 {
    margin: 0;
    color: var(--ink);
    font-family: Aeonik, Geist, ui-sans-serif, system-ui, sans-serif;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .download-card__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .download-card__links,
  .download__more {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 14.5px;
  }

  .download-card__links a,
  .download__more a {
    color: var(--muted-2);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 3px;
  }

  .download-card__links a:hover,
  .download-card__links a:focus-visible,
  .download__more a:hover,
  .download__more a:focus-visible {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .download-card__commands {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .download-card__commands li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 0 6px 0 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-soft);
  }

  .download-card__commands code {
    overflow-x: auto;
    color: var(--ink);
    font: 500 14px/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    white-space: nowrap;
  }

  .download-card__commands code span {
    color: var(--muted);
  }

  .download-copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    min-width: 36px;
    height: 36px;
    justify-content: center;
    padding: 0 8px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
    transition: color 150ms ease, background 150ms ease;
  }

  .download-copy:hover,
  .download-copy:focus-visible {
    background: var(--line);
    color: var(--ink);
  }

  .download-copy svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .download-copy__status:empty {
    display: none;
  }

  .download__more {
    margin-top: 22px;
  }

  @media (max-width: 860px) {
    .download__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
