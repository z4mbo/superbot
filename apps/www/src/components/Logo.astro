---
import { MARK_SVG_PATH } from "../brand";

type Props = {
  href?: string;
  label?: string;
};

const { href = "/", label = "Superbot home" } = Astro.props as Props;
---

<a class="brand-lockup" href={href} aria-label={label}>
  <img
    class="brand-lockup__mark"
    src={MARK_SVG_PATH}
    width="36"
    height="36"
    alt=""
    aria-hidden="true"
  />
  <span class="brand-lockup__word">Superbot</span>
</a>
