{
  "installCommand": "sh scripts/clone-marketing.sh && corepack pnpm install",
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    },
    {
      "source": "/github",
      "destination": "https://github.com/z4mbo/superbot",
      "permanent": false
    },
    {
      "source": "/docs/plugin-sdk",
      "destination": "/docs/build-an-app/",
      "statusCode": 301
    },
    {
      "source": "/docs/plugin-sdk/",
      "destination": "/docs/build-an-app/",
      "statusCode": 301
    },
    {
      "source": "/docs/plugin-sdk.md",
      "destination": "/docs/build-an-app.md",
      "statusCode": 301
    },
    {
      "source": "/docs/build-a-plugin",
      "destination": "/docs/import-from-github/",
      "statusCode": 301
    },
    {
      "source": "/docs/build-a-plugin/",
      "destination": "/docs/import-from-github/",
      "statusCode": 301
    },
    {
      "source": "/docs/build-a-plugin.md",
      "destination": "/docs/import-from-github.md",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/ai-catalog+json\""
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ai-catalog+json"
        }
      ]
    },
    {
      "source": "/:path(.+)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Link",
          "value": "</>; rel=\"canonical\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/ai-catalog+json\""
        }
      ]
    },
    {
      "source": "/:path((?!index\\.md$|404\\.md$).+)\\.md",
      "headers": [
        {
          "key": "Link",
          "value": "</:path/>; rel=\"canonical\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/ai-catalog+json\""
        }
      ]
    }
  ]
}
